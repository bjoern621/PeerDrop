{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/backend/backend.sln",
                "/property:GenerateFullPaths=true",
                {
                    "value": "/consoleloggerparameters:NoSummary;ForceNoAlign",
                    "quoting": "strong"
                }
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/backend/backend.sln",
                "/property:GenerateFullPaths=true",
                {
                    "value": "/consoleloggerparameters:NoSummary;ForceNoAlign",
                    "quoting": "strong"
                }
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/backend/backend.sln"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}